# Aurvek Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ============================================================================
# CRITICAL - Application will not start without these
# ============================================================================

# Secret key for JWT token signing (generate a random string, 32+ chars)
APP_SECRET_KEY=your-super-secret-key-change-this

# Pepper for password hashing (generate a random string, 32+ chars)
PEPPER=your-pepper-secret-change-this

# Database filename under the repository's db/ directory
DATABASE=Aurvek.db

# Set to "true" when running behind HTTPS to mark cookies as secure
# SECURE_COOKIES=false

# Debug mode: enables verbose logging and tracemalloc (development only)
# APP_DEBUG=false

# ============================================================================
# AI PROVIDER API KEYS (at least one required for AI features)
# ============================================================================

# OpenAI API Key (for GPT models, DALL-E, TTS, Whisper)
OPENAI_KEY=sk-...

# Anthropic API Key (for Claude models)
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini API Key
GEMINI_KEY=AIza...

# xAI API Key (for Grok models)
XAI_KEY=xai-...

# Google Maps Directions API (for route navigation tool)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# OpenRouter API Key (for accessing multiple models via OpenRouter)
OPENROUTER_API_KEY=sk-or-...

# Perplexity API Key (for Perplexity models)
PERPLEXITY_API_KEY=pplx-...

# ============================================================================
# TEXT-TO-SPEECH / SPEECH-TO-TEXT
# ============================================================================

# TTS Engine: 'elevenlabs' or 'openai'
TTS_ENGINE=elevenlabs

# STT Engine: 'elevenlabs' or 'deepgram'
STT_ENGINE=elevenlabs

# ElevenLabs API Key (for TTS/STT)
ELEVEN_KEY=...

# Deepgram API Key (alternative STT)
DEEPGRAM_KEY=...

# ============================================================================
# IMAGE GENERATION
# ============================================================================

# Image generation engine: 'dalle', 'ideogram', or 'gemini'
IMAGE_GENERATION_ENGINE=dalle

# Ideogram API Key
IDEOGRAM_API_KEY=...

# ============================================================================
# VIDEO GENERATION
# ============================================================================

# Video generation engine: 'veo' (Google VEO)
VIDEO_GENERATION_ENGINE=veo

# ============================================================================
# TWILIO (for WhatsApp/SMS integration)
# ============================================================================

TWILIO_SID=AC...
TWILIO_AUTH=...
SERVICE_SID=MG...

# ============================================================================
# EMAIL SERVICE
# ============================================================================

# Explicitly enable Postmark delivery. Set to false only when email delivery
# should fail closed (no codes or links are written to logs).
USE_EMAIL_SERVICE=true
# Postmark server token used by email_service.py
POSTMARK_SERVER_TOKEN=...
# Verified sender address configured in Postmark
FROM_EMAIL=noreply@example.com

# ============================================================================
# PAYMENT PROCESSING
# ============================================================================

# PayPal configuration (use sandbox for testing)
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
PAYPAL_MODE=sandbox

# Stripe configuration (required for payments and creator payouts)
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Webhook secret from https://dashboard.stripe.com/webhooks
# Required events: checkout.session.completed, account.updated, transfer.failed, charge.dispute.created
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================================================
# CAPTCHA (optional, disabled by default)
# ============================================================================

# Supported providers: turnstile, recaptcha, none
# CAPTCHA_PROVIDER=none
# For Cloudflare Turnstile:
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# For Google reCAPTCHA v3:
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
# RECAPTCHA_SCORE_THRESHOLD=0.3

# ============================================================================
# CLOUDFLARE (optional - for CDN and image delivery)
# ============================================================================

# Set to 'true' to use Cloudflare for image delivery
CLOUDFLARE_FOR_IMAGES=false

CLOUDFLARE_API_KEY=...
CLOUDFLARE_EMAIL=...
CLOUDFLARE_ZONE_ID=...
CLOUDFLARE_API_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_SECRET=...
CLOUDFLARE_IMAGE_SUBDOMAIN=...
CLOUDFLARE_BASE_URL=...

# Platform base domain (for geo-fencing URL matching, e.g., "aurvek.example.com")
PLATFORM_DOMAIN=

# Cloudflare DNS Management (optional - for auto-creating user subdomains)
# Base domain for user subdomains (e.g., "example.com" creates "user.example.com")
CLOUDFLARE_DOMAIN=
# CNAME target for subdomains (your server's public hostname)
CLOUDFLARE_CNAME_TARGET=
# Second zone ID (optional, for cache disabler with multiple domains)
CLOUDFLARE_ZONE_ID_2=

# ============================================================================
# IMAGE AUTH IP WHITELIST (optional - for Cloudflare Zero Trust)
# ============================================================================

# Comma-separated list of allowed IPs (e.g., "127.0.0.1,10.0.0.1")
AUTH_IMAGE_ALLOWED_IPS=127.0.0.1
# Comma-separated IP prefixes to allow (e.g., "192.168.,10.0.")
AUTH_IMAGE_ALLOWED_PREFIXES=

# ============================================================================
# CDN CONFIGURATION (optional)
# ============================================================================

# Set to 'true' to enable CDN for static assets
ENABLE_CDN=false
CDN_BASE_URL=

# Cache-busting: append ?v=<content-hash> to static asset URLs (default: true)
# Set to 'false' to disable (useful for frequent restarts during debugging)
CACHE_BUSTING=true

# ============================================================================
# APPLICATION LIMITS
# ============================================================================

# Maximum tokens per AI response
MAX_TOKENS=4096

# Maximum tokens per user (usage limit)
TOKEN_LIMIT=500000

# Maximum message size in characters
MAX_MESSAGE_SIZE=5120

# Maximum image upload size in bytes (default 10MB)
MAX_IMAGE_UPLOAD_SIZE=10485760

# Maximum image pixels (default 50 megapixels)
MAX_IMAGE_PIXELS=50000000

# Image token expiration in hours
# AVATAR: User profile pictures and bot/prompt avatars (default 8 hours)
AVATAR_TOKEN_EXPIRE_HOURS=8
# MEDIA: Conversation images, videos, generated content (default 1 hour)
MEDIA_TOKEN_EXPIRE_HOURS=1

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable OpenAI moderation API for content filtering
USE_MODERATION_API=false

# Marketplace kill switch.
# Copying this example keeps OSS/private deployments lean by default.
# Set MARKETPLACE_ENABLED=true only when public marketplace surfaces are intended.
MARKETPLACE_ENABLED=false
MARKETPLACE_PUBLIC_LANDINGS_ENABLED=false
MARKETPLACE_CHECKOUT_ENABLED=false
MARKETPLACE_STOREFRONTS_ENABLED=false
MARKETPLACE_DISCOVERY_ENABLED=false
MARKETPLACE_CREATOR_TOOLS_ENABLED=false


# ============================================================================
# PERFORMANCE TUNING
# ============================================================================

# JWT token cache size (default 100000)
JWT_CACHE_SIZE=100000

# ============================================================================
# DEBUG MODE (set to 'false' in production!)
# ============================================================================

DEBUG=false

# ============================================================================
# REDIS (optional - for rate limiting and caching)
# ============================================================================

REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Enable Redis for image tokens (1 = enabled, 0 = disabled)
REDIS_IMG_TOKEN=0

# ============================================================================
# NGINX PATHS (all nginx paths derive from this base)
# ============================================================================

# Path to nginx base directory (all nginx paths derive from this)
# Windows/Laragon example: C:/laragon/bin/nginx/nginx-1.22.0
# Linux example: /etc/nginx
NGINX_BASE_PATH=

# ============================================================================
# SECURITY TRACKER (scanner/bot protection)
# ============================================================================

# Backend mode for middleware security tracker:
# - auto: use Redis when available, fallback to in-memory
# - off: in-memory only
SECURITY_REDIS_MODE=auto
SECURITY_REDIS_PREFIX=security
SECURITY_REDIS_RECOVERY_COOLDOWN_SECONDS=30
SECURITY_REDIS_HEALTHCHECK_INTERVAL_SECONDS=10
SECURITY_EVENTS_RETENTION=500

# Optional automatic Cloudflare escalation for repeated blocked IPs
# Requires CLOUDFLARE_EMAIL, CLOUDFLARE_API_KEY, and either
# SECURITY_CF_ACCOUNT_ID or CLOUDFLARE_ZONE_ID.
SECURITY_CF_ESCALATION_ENABLED=0
SECURITY_CF_ESCALATION_THRESHOLD=3
SECURITY_CF_ESCALATION_TIMEOUT_SECONDS=5
SECURITY_CF_ESCALATION_NOTES_PREFIX=aurvek-security-auto
SECURITY_CF_ESCALATION_BLOCK_HOURS=168
SECURITY_CF_ACCOUNT_ID=

# Active scan escalation: escalate to CF when a blocked IP keeps hammering with 403s
# SECURITY_CF_ACTIVE_SCAN_THRESHOLD: number of 403 hits from a blocked IP to trigger CF escalation (default 50)
# SECURITY_CF_ACTIVE_SCAN_WINDOW_SECONDS: time window in seconds for counting hits (default 120)
SECURITY_CF_ACTIVE_SCAN_THRESHOLD=50
SECURITY_CF_ACTIVE_SCAN_WINDOW_SECONDS=120

# ============================================================================
# DURABLE MEMORY PROVIDERS (optional)
# ============================================================================

# Active provider: none, atagia, or mem0.
# Missing value preserves legacy Atagia-enabled installs; new installs default to none.
MEMORY_ACTIVE_PROVIDER=none

# Default scope for users: prompt isolates by prompt/persona, global shares by user.
MEMORY_DEFAULT_SCOPE=prompt

# Local recent-history context budget used only when MEMORY_ACTIVE_PROVIDER=none.
# This is further capped by each model's input window at runtime.
MEMORY_NONE_CONTEXT_MAX_TOKENS=128000
# JSON list of exceptions, e.g. [{"type":"prompt","id":12,"max_tokens":500000}]
MEMORY_NONE_CONTEXT_EXCEPTIONS=[]

# Mem0 OSS self-hosted REST server. Hosted Mem0 Platform URLs are not supported.
MEM0_BASE_URL=http://127.0.0.1:8888
MEM0_API_KEY=
# Unique namespace per Aurvek install when sharing one Mem0 server.
MEM0_PLATFORM_ID=aurvek-local
MEM0_TIMEOUT_SECONDS=30.0
MEM0_TOP_K=8

# ============================================================================
# DATABASE TUNING (optional)
# ============================================================================

DB_TIMEOUT=5.0
DB_MAX_RETRIES=3
DB_RETRY_DELAY_BASE=0.2

# ============================================================================
# ELEVENLABS REAL-TIME VOICE (optional)
# ============================================================================

ELEVENLABS_CONVAI_BASE=https://api.elevenlabs.io/v1/convai
ELEVENLABS_USE_SIGNED_URL=true
ELEVENLABS_CONTEXT_LIMIT=20
ELEVENLABS_CONTEXT_MAX_CHARS=8000
ELEVENLABS_HTTP_TIMEOUT=30
ELEVEN_CLIENT_VER=0.5.2

# ============================================================================
# ALLOWED ORIGINS (CORS)
# ============================================================================

# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:7789
